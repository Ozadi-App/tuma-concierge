{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  // Reads the website's own files to check they agree with the shared lists, which tsc's rootDir rules out.
  "exclude": ["src/website-sections.test.ts"]
}
