{
  "account_id": "5b3ae942adb5457f1fa4d7f5effbf3ff",
  "name": "peebee-customer",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // customer.peebee.online stays attached so old links, bookmarks and installed apps still land here;
  // next.config.ts redirects it to app.peebee.online.
  "routes": [
    { "pattern": "app.peebee.online", "custom_domain": true },
    { "pattern": "customer.peebee.online", "custom_domain": true }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    // Works around a known opennextjs-cloudflare bug (pnpm's symlinked
    // node_modules breaks the middleware-manifest.json inlining, causing an
    // unsupported dynamic require() at runtime — opennextjs/opennextjs-cloudflare#1232).
    // Safe here: neither app uses Next.js middleware.
    "NEXT_PRIVATE_MINIMAL_MODE": "1"
  }
}
